/**
 * MemoryMicro.java
 *
 * It has two arrays:
 *   1. programMemory (ROM) - stores the program instructions (16 KB)
 *   2. dataMemory (RAM)    - stores variables/data while running (256 bytes)
 *
 * We use int[] instead of byte[] so values stay between 0 and 255
 * (Java's byte type can go negative, which we don't want here).
 */
public class MemoryMicro {

    // Size of program memory (ROM) = 16 KB
    public static final int ROM_SIZE = 16384;

    // Size of data memory (RAM) = 256 bytes
    public static final int RAM_SIZE = 256;

    // Array to store program instructions
    private int[] programMemory;

    // Array to store runtime data
    private int[] dataMemory;

    // Constructor: create both memory arrays
    public MemoryMicro() {
        programMemory = new int[ROM_SIZE];
        dataMemory = new int[RAM_SIZE];
    }

    // Load a program (array of instruction bytes) into ROM starting at address 0
    public void loadProgram(int[] code) {
        for (int i = 0; i < code.length; i++) {
            programMemory[i] = code[i] & 0xFF; // keep only 8 bits (0-255)
        }
    }

    // Read one instruction byte from ROM at the given address
    public int readProgram(int address) {
        return programMemory[address] & 0xFF;
    }

    // Read one data byte from RAM at the given address
    public int readData(int address) {
        return dataMemory[address] & 0xFF;
    }

    // Write a value into RAM at the given address
    public void writeData(int address, int value) {
        dataMemory[address] = value & 0xFF; // keep only 8 bits (0-255)
    }

    // Reset both ROM and RAM back to all zeros
    public void reset() {
        for (int i = 0; i < ROM_SIZE; i++) {
            programMemory[i] = 0;
        }
        for (int i = 0; i < RAM_SIZE; i++) {
            dataMemory[i] = 0;
        }
    }

    // Simple main method to test the Memory class
    public static void main(String[] args) {

        // Create a memory object
        MemoryMicro memory = new MemoryMicro();

        // Sample program: a few instruction bytes
        int[] program = {0x74, 0x05, 0xF8, 0x00};

        // Load the program into ROM
        memory.loadProgram(program);

        // Write some values into RAM
        memory.writeData(0x00, 10);
        memory.writeData(0x01, 20);

        // Read and print instructions from ROM
        System.out.println("Program Memory (ROM) contents:");
        for (int i = 0; i < program.length; i++) {
            System.out.println("Address 0x" + Integer.toHexString(i)
                    + " -> " + memory.readProgram(i));
        }

        // Read and print data from RAM
        System.out.println("\nData Memory (RAM) contents:");
        System.out.println("Address 0x00 -> " + memory.readData(0x00));
        System.out.println("Address 0x01 -> " + memory.readData(0x01));

        // Reset memory and confirm it's cleared
        memory.reset();
        System.out.println("\nAfter reset:");
        System.out.println("Address 0x00 in ROM -> " + memory.readProgram(0x00));
        System.out.println("Address 0x00 in RAM -> " + memory.readData(0x00));
    }
}
